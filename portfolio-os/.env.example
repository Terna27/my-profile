# Server Configuration
PORT=3000

# PostgreSQL Database Connection URL
# Format: postgres://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/portfolio_db?sslmode=disable

# Admin Dashboard Authentication
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION=your_random_32_character_session_secret_here

# Local & Persistent Storage Directory
# In local development: defaults to ./uploads relative to application root
# On Render / Production: set to the absolute mount path of your persistent disk (e.g. /var/data/uploads)
UPLOAD_DIR=./uploads
